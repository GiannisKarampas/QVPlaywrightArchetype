{
  "name": "qv-playwright-archetype",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright + TypeScript automation framework archetype for UI and API testing",
  "main": "index.js",
  "scripts": {
    "initialize": "npm install && npx playwright install && npx playwright install-deps",
    "allure": "allure generate ./test-results/allure-results -o allure-report --clean && allure open allure-report -h localhost -p 8081",
    "allure_generate": "allure generate ./test-results/allure-results -o allure-report --clean",
    "test": "npx playwright test",
    "test:report": "npx playwright test || cmd /c exit 0 && npm run allure",
    "test:ui": "playwright test tests/ui --project=chromium",
    "test:api": "playwright test tests/api --project=api",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/accessibility --project=accessibility",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:parallel": "playwright test --workers=4",
    "test:serial": "playwright test --workers=1",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:critical": "playwright test --grep @critical",
    "test:slow": "playwright test --grep @slow --workers=1",
    "test:tag": "playwright test --grep",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean && allure open",
    "report:allure-generate": "allure generate allure-results --clean -o allure-report",
    "report:allure-open": "allure open allure-report",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf allure-results allure-report playwright-report test-results",
    "pretest": "npm run type-check",
    "prepare": "husky",
    "docker:build": "docker build -f docker/Dockerfile -t playwright-tests .",
    "docker:run": "docker-compose -f docker/docker-compose.yml up",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "install:browsers": "playwright install --with-deps"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "e2e",
    "api-testing",
    "ui-testing",
    "test-framework",
    "archetype"
  ],
  "author": "QV Automation Team",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.2.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "winston": "^3.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "allure-playwright": "^3.0.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
