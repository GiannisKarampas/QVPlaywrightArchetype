# Production Environment Configuration
NODE_ENV=production
TEST_ENV=prod

# Base URLs
BASE_URL=https://example.com
API_BASE_URL=https://api.example.com

# Test Configuration
HEADLESS=true
BROWSER=chromium
TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=10000

# Parallel Execution
WORKERS=6
RETRIES=2

# Screenshots & Videos
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_RETRY=true

# Logging
LOG_LEVEL=warn
LOG_TO_FILE=true

# Test User Credentials
TEST_USER_EMAIL=prod-user@example.com
TEST_USER_PASSWORD=ProdPass123!
TEST_ADMIN_EMAIL=prod-admin@example.com
TEST_ADMIN_PASSWORD=ProdAdmin123!

# API Configuration
API_TIMEOUT=15000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=2000

# Visual Testing
VISUAL_THRESHOLD=0.1
VISUAL_UPDATE_SNAPSHOTS=false

# Database
DB_HOST=prod-db.example.com
DB_PORT=5432
DB_NAME=prod_db
DB_USER=prod_user
DB_PASSWORD=prod_password

# Reporting
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report

# CI/CD Flags
CI=true
