# Development Environment Configuration
NODE_ENV=development
TEST_ENV=dev

# Base URLs
BASE_URL=https://dev.example.com
API_BASE_URL=https://api-dev.example.com

# Test Configuration
HEADLESS=false
BROWSER=chromium
TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=10000

# Parallel Execution
WORKERS=2
RETRIES=1

# Screenshots & Videos
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=false
TRACE_ON_RETRY=true

# Logging
LOG_LEVEL=debug
LOG_TO_FILE=true

# Test User Credentials
TEST_USER_EMAIL=dev-user@example.com
TEST_USER_PASSWORD=DevPass123!
TEST_ADMIN_EMAIL=dev-admin@example.com
TEST_ADMIN_PASSWORD=DevAdmin123!

# API Configuration
API_TIMEOUT=20000
API_RETRY_ATTEMPTS=2
API_RETRY_DELAY=1000

# Visual Testing
VISUAL_THRESHOLD=0.2
VISUAL_UPDATE_SNAPSHOTS=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dev_test_db
DB_USER=dev_user
DB_PASSWORD=dev_password

# Reporting
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report

# CI/CD Flags
CI=false
